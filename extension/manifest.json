{
  "manifest_version": 3,
  "name": "XAI Phishing Detector",
  "description": "Analyze URLs, emails, and phone numbers for phishing using your local Flask backend.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://xai-phishing-detector-3ipl.onrender.com/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XAI Phishing Detector"
  }
}
